{
  "name": "clean-track-pro",
  "version": "1.0.0",
  "description": "Application SaaS multi-tenant pour la gestion de pressing avec suivi en temps réel.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test tests/e2e/admin",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report playwright-report",
    "dev:up": "docker compose -f docker-compose.dev.yml up -d --build",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "dev:reset": "docker compose -f docker-compose.dev.yml down -v",
    "e2e:infra": "docker compose -f docker-compose.yml -f docker-compose.e2e.yml up -d postgres keycloak redis",
    "e2e:bootstrap": "node scripts/e2e/bootstrap.mjs",
    "e2e:run": "node scripts/e2e/run-e2e.mjs",
    "e2e:run:admin": "node scripts/e2e/run-e2e.mjs tests/e2e/admin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AQUILA04/clean-track-pro.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AQUILA04/clean-track-pro/issues"
  },
  "homepage": "https://github.com/AQUILA04/clean-track-pro#readme",
  "dependencies": {
    "@keycloak/keycloak-admin-client": "^26.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^25.2.0"
  }
}
