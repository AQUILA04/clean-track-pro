# Optional overrides for docker-compose.dev.yml
# Copy to .env (Compose loads it automatically) or:
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cleantrack

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=cleantrack
KEYCLOAK_CLIENT_ID=cleantrack-client
KEYCLOAK_CLIENT_SECRET=cleantrack-dev-secret

# Keycloak realm SMTP (MailDev in docker-compose.dev.yml)
KEYCLOAK_SMTP_HOST=maildev
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=suppoort@cleantrack.pro
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=Support CleanTrackPro
KEYCLOAK_SMTP_REPLY_TO=suppoort@cleantrack.pro
KEYCLOAK_SMTP_REPLY_TO_DISPLAY_NAME=Support CleanTrackPro

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=cleantrack-dev-nextauth-secret-min-32-chars
KEYCLOAK_ISSUER=http://localhost:8080/realms/cleantrack

FRONTEND_URL=http://localhost:3001
# Stripe (dev / test mode) — put real keys in local .env (gitignored), not here
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_28EaEZdxx52n2g95LW0ZW00
