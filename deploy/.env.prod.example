# =============================================================================
# CleanTrack Pro — PROD .env template
# Copy to /opt/cleantrack/prod/.env on the server (never commit real secrets).
# Generated automatically by setup-server.sh / init.sh on first deploy.
# =============================================================================

DB_USER=cleantrack
DB_PASSWORD=CHANGE_ME_prod_db_password
DB_NAME=cleantrack_prod

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password
KEYCLOAK_HOSTNAME=cleantrack-auth.optimizesolux.com
KEYCLOAK_REALM=cleantrack
KEYCLOAK_CLIENT_ID=cleantrack-client
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_keycloak_client_secret
KEYCLOAK_AUTH_SERVER_URL=https://cleantrack-auth.optimizesolux.com
KEYCLOAK_ISSUER=https://cleantrack-auth.optimizesolux.com/realms/cleantrack

APP_HOSTNAME=cleantrack.optimizesolux.com
API_HOSTNAME=cleantrack-api.optimizesolux.com
CORS_ORIGINS=https://cleantrack.optimizesolux.com

NEXT_PUBLIC_API_URL=https://cleantrack-api.optimizesolux.com
NEXTAUTH_URL=https://cleantrack.optimizesolux.com
NEXTAUTH_SECRET=CHANGE_ME_nextauth_secret

# Resend SMTP (domain optimizesolux.com must be verified in Resend)
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USER=resend
MAIL_PASS=CHANGE_ME_resend_api_key
MAIL_FROM="CleanTrackPro <noreply@optimizesolux.com>"

# Optional overrides for Keycloak realm email (defaults to MAIL_* above)
# Username = always "resend" ; Password = Resend API key (same as MAIL_PASS)
# KEYCLOAK_SMTP_HOST=smtp.resend.com
# KEYCLOAK_SMTP_PORT=465
# KEYCLOAK_SMTP_USER=resend
# KEYCLOAK_SMTP_PASSWORD=CHANGE_ME_resend_api_key
# KEYCLOAK_SMTP_FROM=noreply@optimizesolux.com
# KEYCLOAK_SMTP_FROM_DISPLAY_NAME=CleanTrackPro

# Custom Keycloak theme (mounted into container). Prefer also using cleantrack-keycloak image.
KEYCLOAK_THEMES_PATH=/opt/cleantrack/repo/keycloak/themes/cleantrack-pro

# Populated automatically by deploy.sh — do not edit manually
FRONTEND_IMAGE=
BACKEND_IMAGE=
KEYCLOAK_IMAGE=
