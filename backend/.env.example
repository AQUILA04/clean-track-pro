# Backend Environment Variables

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=clean_track_pro

# Keycloak
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=cleantrack
KEYCLOAK_CLIENT_ID=cleantrack-client
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Keycloak Admin (for setup script)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_REALM=master

# Frontend (Stripe redirects)
FRONTEND_URL=http://localhost:3001

# Stripe (test mode) — put real keys in local backend/.env (gitignored)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_28EaEZdxx52n2g95LW0ZW00

# Email notifications — local: MailDev ; prod: Resend SMTP
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@cleantrack.local
# Prod (Resend): MAIL_HOST=smtp.resend.com MAIL_PORT=465 MAIL_USER=resend MAIL_PASS=re_…
# MAIL_FROM="CleanTrackPro <noreply@optimizesolux.com>"

# SMS via Twilio (optional — logs to console if unset)
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
